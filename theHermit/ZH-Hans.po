msgctxt "VOTable"
msgid "<Subtitle_Ruxtin>I wonder if I'd look good in blue.</>  <Subtitle_ShovelKnight>I think someone beat you to it.</>"
msgstr "<Subtitle_Ruxtin>我想知道我穿蓝色会不会好看。</><Subtitle_ShovelKnight>我觉得有人抢先了。</>"

#. Key:	DeliverThisLetter_VOLines
#. SourceLocation:	/Game/ToyBattler/Data/Audio/VOTable.VOTable.IdleShopGravediggers.VOLines_29_90CB93774357BC45CBD51BB2E25FCC96(8).VOLines_29_90CB93774357BC45CBD51BB2E25FCC96.Subtitle_29_34E87B914A96442F0F0B738F6540A623
