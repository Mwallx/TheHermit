msgid "<Subtitle_ShovelKnight>*singing*  I am a knight and I'm digging a hole.  Diggy diggy hole.  Diggy diggy hole.</>"
msgstr "<Subtitle_ShovelKnight>*唱歌* 我是一个骑士，我在挖洞。挖挖洞。挖挖洞。</>"

