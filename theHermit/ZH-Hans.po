#: Bytecode]
msgid ""
"<text s=\"signcurse\">Those seeking knowledge you've kept from pursuing</>\r\n"
"<text s=\"signcurse\">Hoarding such wisdom will be your undoing</>"
msgstr ""
"<text s=\"signcurse\">私藏典籍求知断</>\n"
"<text s=\"signcurse\">强夺真知祸患生</>"

#. Key:	C0356CF242FAAE5DEA66AE86F131B467
#. SourceLocation:	/Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script Bytecode]
#: /Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script
#: Bytecode]
msgid ""
"<text s=\"signcurse\">You risked it all, and now you'll suffer</>\r\n"
"<text s=\"signcurse\">The road ahead will now be rougher</>"
msgstr ""
"<text s=\"signcurse\">踏危行，苦将至</>\r\n"
"<text s=\"signcurse\">望前路，荆棘伺</>"

#. Key:	CC69DD8D467A87EB444D339AEC4AF072
#. SourceLocation:	/Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script Bytecode]
#: /Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script
#: Bytecode]
msgid ""
"<text s=\"signcurse\">Chaos born of malcontent</>\r\n"
"<text s=\"signcurse\">Shall only cause you to lament</>"
msgstr ""
"<text s=\"signcurse\">不甘之念</>\n"
"<text s=\"signcurse\">尽生悲叹</>"

#. Key:	E44614D24DA82F38826BF58980C61968
#. SourceLocation:	/Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script Bytecode]
#: /Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script
#: Bytecode]
msgid ""
"<text s=\"signcurse\">A thunderous voice, a piercing scream</>\r\n"
"<text s=\"signcurse\">Now that sound will haunt your dreams</>"
msgstr ""
"<text s=\"signcurse\">雷鸣惊啸</>\n"
"<text s=\"signcurse\">长夜萦绕</>"

#. Key:	F1E4F80E4BA53B40A2D5A28DE5EF2C0A
#. SourceLocation:	/Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script Bytecode]
#: /Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script
#: Bytecode]
msgid ""
"<text s=\"signcurse\">Your pockets you tried to line with gold</>\r\n"
"<text s=\"signcurse\">Now a steeper payment must unfold</>"
msgstr ""
"<text s=\"signcurse\">金漫私囊</>\n"
"<text s=\"signcurse\">险债待偿</>"

#. Key:	FC03B235489AD38213ABD4BD05457448
#. SourceLocation:	/Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script Bytecode]
#: /Game/ToyBattler/UI/Events/EventPanel.EventPanel_C:Bad Shrine Signs [Script
#: Bytecode]
msgid ""
"<text s=\"signcurse\">A humble warning you did not heed</>\r\n"
"<text s=\"signcurse\">A curse upon you for your greed</>"
msgstr ""
"<text s=\"signcurse\">告而不闻</>\n"
"<text s=\"signcurse\">贪即召瘟</>"

