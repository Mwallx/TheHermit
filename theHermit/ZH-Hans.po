#. Key:	E74B081941DC3954E8DEEEA3324FB58C
#. SourceLocation:	/Game/ToyBattler/Data/PVP/PVPActModifierTable.PVPActModifierTable.CavernMod.Name_4_207932DF4B453CE544D2C8B0C58F221E
#: /Game/ToyBattler/Data/CombatModifier/ActModifierTable.ActModifierTable.CavernMod.Name_4_207932DF4B453CE544D2C8B0C58F221E
#: /Game/ToyBattler/Data/CombatModifier/StatusEffectTable_CombatMods.StatusEffectTable_CombatMods.ManaCrystalArmor.DisplayTextforStatBreakoutBonusDisplay_195_599B3B3B463E8E09BD7C86A06780319B
#: /Game/ToyBattler/Data/PVP/PVPActModifierTable.PVPActModifierTable.CavernMod.Name_4_207932DF4B453CE544D2C8B0C58F221E
msgid "Crystal Heart"
msgstr "水晶之心"

#. Key:	AEA89120448FA22D8A0F969BC4B91D2C
#. SourceLocation:	/Game/ToyBattler/Data/CombatModifier/ActModifierTable.ActModifierTable.CityMod.Description_5_CE96FECF40D9A68B64BE978E224ADBA7
#: /Game/ToyBattler/Data/CombatModifier/ActModifierTable.ActModifierTable.CityMod.Description_5_CE96FECF40D9A68B64BE978E224ADBA7
msgid "After 12 seconds, the Gong rings - all Units gain 200 Max HP and heal 1% Health per second for the rest of combat."
msgstr "战斗开始 12 秒后，所有单位获得 300 点最大生命，且每秒恢复 1% 生命值。"

#. Key:	599A8DA1450BB4D39553E3A6E5E1C89A
#. SourceLocation:	/Game/ToyBattler/Data/CombatModifier/StatusEffectTable_CombatMods.StatusEffectTable_CombatMods.GiantGongBuff.DisplayTextforStatBreakoutBonusDisplay_195_599B3B3B463E8E09BD7C86A06780319B
#. Key:	7F0C047944354EE818B96BB351D1B0B3
