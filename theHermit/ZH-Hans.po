msgid ""
"{name} gains {value0} Shield for 5 seconds. Gains bonus effects with each additional cast.\r\n"
"\r\n"
"2. Heal for {value1.pct} of {name}'s Max HP.\r\n"
"4. Deal {value2} Spell damage to adjacent foes.\r\n"
"6. Skill hits the lowest health ally as well."
msgstr ""
"{name}获得 {value0} 点护盾 5 秒。累积施放多次时造成额外效果。</>\n"
"\n"
"<text>2次：恢复 {value1.pct} 生命值。</>\n"
"<text>4次：对相邻敌方单位造成 {value2} 点法术伤害。</>\n"
"<text>6次：技能额外对生命值最低的友方单位施放。</>"

#. Key:	03F4D4EB46848942EBBD3AB0A1884415
