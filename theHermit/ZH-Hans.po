msgid "<text>The genie beckons you closer, imploring you for your opinion.</>  <text s=\"colorspeech\">\"You look like a nature-friendly {playerrace}.  What do you think?\"</>"
msgstr "<text>灯魂示意你靠近，恳求你的意见。</><text s=\"colorspeech\">“你看起来像是一个亲近自然的{playerrace}。你觉得怎么样？”</>"

#. Key:	280C4FE847460D19CE4CF59BD47C598E
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_Skye.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(3 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
