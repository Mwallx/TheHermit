msgid "{yellow}\"The Very Hungry Hydra\"{text}"
msgstr "{yellow}《饿极三头蛇》{text}"

#. Key:	F1C588B6484E89EF8741739A6567AB04
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Shrine_StarPoints.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(4).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(4 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
