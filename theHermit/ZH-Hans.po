msgctxt "VOTable"
msgid "<Subtitle_ShovelKnight>Would you be so kind as to deliver this letter for me?</>  <Subtitle_Ruxtin>Umm...that's a customer, not a messenger.</>   <Subtitle_ShovelKnight>Well, maybe we could give them a discount!</>"
msgstr "<Subtitle_ShovelKnight>你能帮我送这封信吗？</><Subtitle_Ruxtin>嗯...那是顾客，不是信使。</><Subtitle_ShovelKnight>好吧，也许我们可以给他们打个折！</>"

