msgctxt "VOTable"
msgid "<Subtitle_Ruxtin>This stuff is built to last.</>  <Subtitle_ShovelKnight>Can't say the same for their owners though.</>  <Subtitle_Ruxtin>Hmm...Terribly mortal.</>"
msgstr "<Subtitle_Ruxtin>这些东西经久耐用。</><Subtitle_ShovelKnight>不能说他们的主人也是如此。</><Subtitle_Ruxtin>嗯...非常像凡人。</>"

#. Key:	ChanceForGlory_VOLines
