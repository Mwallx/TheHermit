msgctxt "VOTable"
msgid "<Subtitle_Ruxtin>Of course it's all good stuff! Who'd get buried with junk?  Oh, did I say buried...?</>"
msgstr "<Subtitle_Ruxtin>当然都是好东西！谁会把垃圾埋起来啊？哦，我提到埋了是吗？</>"

#. Key:	BuiltToLast_VOLines
#. SourceLocation:	/Game/ToyBattler/Data/Audio/VOTable.VOTable.IdleShopGravediggers.VOLines_29_90CB93774357BC45CBD51BB2E25FCC96(4).VOLines_29_90CB93774357BC45CBD51BB2E25FCC96.Subtitle_29_34E87B914A96442F0F0B738F6540A623
