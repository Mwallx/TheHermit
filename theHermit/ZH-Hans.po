msgid "Just harmless fun."
msgstr "这玩笑无伤大雅。"

#. Key:	3F4426B643B47F85380003B5F2E16E3D
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_Otto.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextRight_69_3F36DDE74F9C94222FB62CBF461E6FCE
