msgid "<text>Exasperated,</> {skye}<text> turns to you, leering in the doorway.</>  <text s=\"colorspeech\">\"Maybe you can speak his language.  Just tell him that it won't kill him to let me borrow a pawn or two for a while.\"</>"
msgstr "<text>恼怒却又无可奈何的</>{skye}<text>看向了门口的你，想要求助。</><text s=\"colorspeech\">“也许你能和他合得来拍。就跟他说，暂时借用一两枚棋子又不会要了他的命。”</>"

#. Key:	6C27D8C14251E71B149C2B9D4FFA91BF
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Skye_Vs_Otto.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextLeft_67_437043ED494B6BCFF886D7B797E6057C
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Skye_Vs_Otto.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextLeft_67_437043ED494B6BCFF886D7B797E6057C
msgid "Cheating helps you win."
msgstr "兵不厌诈。"

#. Key:	8D982C744E6FCF17B0EB56BD9CA79299
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Skye_Vs_Otto.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextRight_69_3F36DDE74F9C94222FB62CBF461E6FCE
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Skye_Vs_Otto.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextRight_69_3F36DDE74F9C94222FB62CBF461E6FCE
