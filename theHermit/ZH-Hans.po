#. Key:	6D8135B34C51F8F5CA4023AD649937C5
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(4 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(4
#: -
#: Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
msgid "{river}<text>, an imposing female giant, her hands calloused and her face worn with time, gesturing to a gentle genie you recognize as</> {kiodini}<text>.  She doesn't speak, but her motions seem to indicate her passion for</> <text s=\"colorcyan\">artistic storytelling.</>"
msgstr "{river}<text>是一位威严的雌性巨人，她的手掌粗糙，面容被岁月所磨。她的另一边是你认出来的温和灯魂</>{kiodini}<text>。她沉默不语，但动作已经表明了对</><text s=\"colorcyan\">艺术性叙事</><text>的热情。</>"

#. Key:	7F84866F4545C621E86E349840378688
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(5 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(5
#: -
#: Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
msgid "{river} <text>shakes her head at the fablist and turns to you.  She says nothing, but her eyes implore you to offer your</> <text s=\"colorgreen\">opinion</> <text>on the subject.</>"
msgstr "{river}<text>对那位讲故事的人摇了摇头，然后转向你。她没有说话，而是眼神示意你关于这个话题提出自己的</><text s=\"colorgreen\">意见</><text>。</>"

#. Key:	36ABF6564A038AE4F7EAFCB5A1A2E6A2
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextLeft_67_437043ED494B6BCFF886D7B797E6057C
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextLeft_67_437043ED494B6BCFF886D7B797E6057C
msgid "I am more of a reader."
msgstr "我更算是一名读者。"

#. Key:	D2A0B2C04B3F0461634A1B9A75656C52
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextRight_69_3F36DDE74F9C94222FB62CBF461E6FCE
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(1).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.ChoicePhaseUseTwoArtMode-SubtextRight_69_3F36DDE74F9C94222FB62CBF461E6FCE
msgid "The tapestry is stunning."
msgstr "这些挂毯太精美了。"

#. Key:	790EB1AE401CB2C7CA3C7592CE9E24DC
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(2).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescription_9_F498DE9A42F9D995D49E87AAF6C04105
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(2).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescription_9_F498DE9A42F9D995D49E87AAF6C04105
msgid ""
"<text s=\"colorspeech\">\"There you have it</> {river}<text s=\"colorspeech\">, our new friend has spoken.\"</>  {kiodini} <text>flashes you a big smile of gratitude, before turning back to </>{river}<text>.</>  <text s=\"colorspeech\">\"Now don't look so glum. Knit happens, as they say.\"</>  <text>As</> {river} <text>gathers her things to leave,</> {kiodini} <text>turns back to you.</>\r\n"
"\r\n"
"{kiodiniend}"
msgstr ""
"<text s=\"colorspeech\">“听到没</>{river}<text s=\"colorspeech\">，我们的新朋友已经发表了意见。”</>{kiodini}<text>向你露出感激的大笑，然后转向</>{river}<text>。</><text s=\"colorspeech\">“别那么郁闷，世风无常，沙漠的风更叵测。”</></>{river}<text>收拾东西准备离开，</>{kiodini}<text>又转头对着你。</>\n"
"\n"
"{kiodiniend}"

#. Key:	B467ED104582A2D6EC9AABB14F66949E
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(3).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescription_9_F498DE9A42F9D995D49E87AAF6C04105
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(3).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescription_9_F498DE9A42F9D995D49E87AAF6C04105
msgid ""
"{kiodini} <text>guffaws, sounding like a sudden clap of </> <text s=\"shakingyellow\">thunder</> <text>echoing from all directions, as the book disappears in a puff of smoke.</>\r\n"
"\r\n"
"<text s=\"colorspeech\">\"Well, you know what they say, bad choices make good stories. We shall see how our story unfolds when next we meet.\"</>  <text>Sand and wind gather around the djinn, and in an instant, they disappear.</>\r\n"
"\r\n"
"{riverend}"
msgstr ""
"{kiodini}<text>发出一阵大笑，声音像是从四面八方回荡着的</><text s=\"shakingyellow\">雷鸣</><text>。伴随着一缕烟雾，他手中的书本不见了。</>\n"
"\n"
"<text s=\"colorspeech\">“人们常说，荒唐成趣谈。我很期待下次碰面我们能擦出怎样的火花故事。”</><text>风沙围绕着这位灯魂，转眼间他就消失了。</>\n"
"\n"
"{riverend}"

#. Key:	7E3318A14FF475B1E229CF9A89ECC3C4
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventTitle_2_3B4827864EAC6B70C32FBF90A16455A2
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_River.EventTitle_2_3B4827864EAC6B70C32FBF90A16455A2
msgid "A Tale of Two Tales"
msgstr "双奇传说"

#. Key:	EB0ABAF449F1695D7573F5BC762F81A2
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_Skye.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(1 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
#: /Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_Skye.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(1
#: -
#: Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
msgid "{kiodini}<text>, a storyteller of much renown, appears to be scolding the young</> {elitefour} <text>engineer, </>{skye}<text> on the importance of preserving the</> <text s=\"colorgreen\">environment</><text>.  It seems they do not approve of the</> <text s=\"colorcyan\">artificer's</> <text>love of mechanized magic.</>"
msgstr "{kiodini}<text>，一位声望很高的叙事师，似乎在责备年轻的</>{elitefour}<text>工程师</>{skye}<text>，强调保护</><text s=\"colorgreen\">环境</><text>的重要性。</><text>他似乎不赞同这位</><text s=\"colorcyan\">工艺师</><text>对于机械魔力的热爱。</>"

#. Key:	FB942C314E879FCD43D49099569E4F3D
#. SourceLocation:	/Game/ToyBattler/Data/Events/EventTable.EventTable.Champion_Kiodini_Vs_Skye.EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6(0).EventPhases_57_7FF6A1064470EE1925FAD39D4D57EFB6.TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343(2 - Value).TextPhaseDescriptionTagReplacements_39_61F94971479C35E7C71367A2CA76F343_Value
