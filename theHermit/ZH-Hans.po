msgctxt "VOTable"
msgid "Nice roll."
msgstr "不错啊。"

#. Key:	TemporaryCondition_VOLines
#. SourceLocation:	/Game/ToyBattler/Data/Audio/VOTable.VOTable.GraveyardIntro.VOLines_29_90CB93774357BC45CBD51BB2E25FCC96(0).VOLines_29_90CB93774357BC45CBD51BB2E25FCC96.Subtitle_29_34E87B914A96442F0F0B738F6540A623
