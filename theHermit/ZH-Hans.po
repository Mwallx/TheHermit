msgctxt "VOTable"
msgid "Poisoner... and poison him too!"
msgstr "毒师...也毒死他！"

#. Key:	TasteTheirVenom_VOLines
#. SourceLocation:	/Game/ToyBattler/Data/Audio/VOTable.VOTable.Poisoner.VOLines_29_90CB93774357BC45CBD51BB2E25FCC96(1).VOLines_29_90CB93774357BC45CBD51BB2E25FCC96.Subtitle_29_34E87B914A96442F0F0B738F6540A623
