msgid "Soulburn Greaves"
msgstr "灼魂护胫"

#. Key:	CA1D2F3E4FCEB8F5B571B7ADA4586AD0
#. SourceLocation:	/Game/ToyBattler/Data/Items/ItemTable.ItemTable.SoulburnGloves.EffectDescription_15_FA6310A443299813539ED98A81444743
#: /Game/ToyBattler/Data/Items/ItemTable.ItemTable.SoulburnGloves.EffectDescription_15_FA6310A443299813539ED98A81444743
