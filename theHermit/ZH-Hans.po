msgctxt "VOTable"
msgid "<Subtitle_ShovelKnight>Every grave is a chance for glory!</>  <Subtitle_Ruxtin>Who told you that?</>"
msgstr "<Subtitle_ShovelKnight>每个坟墓都是获得荣耀的机会！</><Subtitle_Ruxtin>谁告诉你的？</>"

